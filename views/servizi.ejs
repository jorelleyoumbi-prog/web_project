<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel ="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <title>Cameroonian's Food</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

<%- include('partials/header') %>

<!-- order section -->
<section class="order" id="order">
    <h3 class="sub-heading">Order Now</h3>
    <h1 class="heading">Free and Fast</h1>

    <form action="/servizi" method="POST">
        <div class="inputBox">
            <div class="input">
                <span>Your name</span>
                <input type="text" name="name" placeholder="Enter your name" required autocomplete="name">
            </div>
            <div class="input">
                <span>Your number</span>
                <input type="text" name="phone" placeholder="Enter your number" required autocomplete="tel">
            </div>
        </div>

        <div class="inputBox">
            <div class="input">
                <span>Your order</span>
                <input type="text" name="order_name" value="<%= typeof dish !== 'undefined' ? dish : '' %>" placeholder="Enter food name" required autocomplete="off">
            </div>
            <div class="input">
                <span>Additional food</span>
                <input type="text" name="additional_food" placeholder="Extra with food" autocomplete="off">
            </div>
        </div>

        <div class="inputBox">
            <div class="input">
                <span>How much</span>
                <input type="number" name="quantity" placeholder="How many orders" min="1" required autocomplete="off">
            </div>
            <div class="input">
                <span>Date and Time</span>
                <input type="datetime-local" name="date_time" required autocomplete="off">
            </div>
        </div>

        <div class="inputBox">
            <div class="input">
                <span>Your address</span>
                <textarea name="address" placeholder="Enter your address" cols="30" rows="10" required autocomplete="street-address"></textarea>
            </div>
            <div class="input">
                <span>Your message</span>
                <textarea name="message" placeholder="Enter your message (optional)" cols="30" rows="10" autocomplete="off"></textarea>
            </div>
        </div>

    <div class="inputBox">
      <div class="input">
         <span>Payment method</span>
         <select name="payment_method" required autocomplete="cc-type">
             <option value="cash">Cash</option>
             <option value="card">Card</option>
          </select>
        </div>
    </div>


        <input type="submit" value="Order now" class="btn">
    </form>
    <% if (typeof error !== "undefined") { %>
      <p style="color: red; font-weight: bold; text-align: center;"><%= error %></p>
    <% } %>

    <% if (typeof success !== "undefined") { %>
        <p style="color: green; font-weight: bold; text-align: center;"><%= success %></p>
    <% } %>
</section>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="script.js"></script>
</body>
</html>
